Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct browser access to internal application folders
    RewriteRule ^(app|config|core|database|modules|storage|views)(/|$) - [F,L]
    RewriteRule ^(INSTALL\.md|\.git) - [F,L]

    # Serve existing public files directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route everything else through the front controller
    RewriteRule ^ index.php [L,QSA]
</IfModule>
